<?xml version="1.0" encoding="UTF-8" ?>
<config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <cache-template name="authentificationDefaults">
        <expiry>
            <ttl>600</ttl>
        </expiry>
        <resources>
            <heap>100</heap>
        </resources>
    </cache-template>

    <cache alias="utilisateurs" uses-template="authentificationDefaults"/>

    <cache alias="fonctions" uses-template="authentificationDefaults"/>

    <cache alias="iam-public-keys" uses-template="authentificationDefaults">
        <expiry>
            <ttl>86400</ttl>
        </expiry>
        <resources>
            <heap>10</heap>
        </resources>
    </cache>

    <cache alias="iam-tokens" uses-template="authentificationDefaults"/>

    <cache alias="iam-basic-auth" uses-template="authentificationDefaults">
        <expiry>
            <ttl>86400</ttl>
        </expiry>
    </cache>
</config>